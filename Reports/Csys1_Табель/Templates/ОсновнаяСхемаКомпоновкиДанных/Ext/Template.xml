		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказПокупателя.Дата КАК Дата,
	ЗаказПокупателя.Контрагент КАК Контрагент,
	ЗаказПокупателя.Комментарий КАК Комментарий,
	ЗаказПокупателя.Договор КАК Договор,
	ЗаказПокупателя.csys1_Табель.(
		Номенклатура КАК Номенклатура,
		Количество КАК Количество,
		Комментарий КАК Комментарий,
		НАЧАЛОПЕРИОДА(ЗаказПокупателя.csys1_Табель.ДатаВыполнения, ДЕНЬ)  КАК ДатаВыполнения,
		НАЧАЛОПЕРИОДА(ЗаказПокупателя.csys1_Табель.ДатаВыполнения, МЕСЯЦ) КАК МесяцВыполнения) КАК Табель,
	ЗаказПокупателя.Ссылка КАК Ссылка
ИЗ
	Документ.ЗаказПокупателя КАК ЗаказПокупателя
ГДЕ
	ЗаказПокупателя.Проведен = ИСТИНА
	И ЗаказПокупателя.csys1_Табель.ДатаВыполнения МЕЖДУ &amp;СтдНачалоПериода И &amp;СтдКонецПериода</query>
	</dataSet>
