Функция УбратьЛидирующиеНули(НомерДокумента)
	
	Попытка
		НомерДокумента = Формат(Число(НомерДокумента), "ЧГ=");
	Исключение
		НомерДокумента = СтрЗаменить(СокрЛ(СтрЗаменить(СокрП(НомерДокумента), "0", " ")), " ", "0");
	КонецПопытки;
	
	Возврат НомерДокумента;
	
